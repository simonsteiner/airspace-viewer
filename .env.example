# Environment variables read by the app. Nothing loads this file automatically:
# export the variables in your shell, or set them as Fly secrets in production
# (see docs/deployment.md). None are needed for local development.

# Signs the Flask session cookie (flash messages). Required in production;
# without it the app uses a hard-coded development key.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Alternative name for FLASK_SECRET_KEY, used only when FLASK_SECRET_KEY is unset.
# SECRET_KEY=

# Currently has no effect: it is read only when logging is first set up outside
# a Flask app context, and nothing sets a logger level from it (create_app()
# always sets INFO). Kept here because the code still reads it.
# AIRSPACE_DEBUG=false
